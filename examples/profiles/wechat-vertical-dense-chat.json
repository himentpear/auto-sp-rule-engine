{
  "name": "wechat_vertical_dense_chat",
  "roi": null,
  "preprocessing": {
    "grayscale": true,
    "scale": 2.4,
    "threshold": {
      "enabled": false,
      "value": 188
    },
    "trim_border": {
      "enabled": false,
      "margin": 0
    },
    "mask_regions": [
      {
        "unit": "ratio",
        "x": 0.0,
        "y": 0.0,
        "width": 1.0,
        "height": 0.145
      },
      {
        "unit": "ratio",
        "x": 0.0,
        "y": 0.758,
        "width": 1.0,
        "height": 0.242
      }
    ]
  },
  "normalization": {
    "collapse_whitespace": true,
    "preserve_line_breaks": true,
    "case": "none",
