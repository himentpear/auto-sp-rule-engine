  "behavior": {
    "fallback_to_full_window_on_empty": true
  },
  "watch": {
    "enabled": false,
    "polling_interval_seconds": 0.5,
    "max_checks": 1,
    "change_threshold": 0.004,
    "forced_ocr_interval_seconds": 5.0,
