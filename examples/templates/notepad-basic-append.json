{
  "schema_version": "designer-template/v1",
  "id": "notepad-basic-append",
  "label": "Notepad Basic Append",
  "category": "validated-app",
  "summary": "Start from the validated primary Notepad target and a minimal append_text rule.",
  "recommended_target_bundle_ref": "primary_notepad",
  "recommended_ocr_profile_ref": "primary_full_window",
  "recommended_roi_preset": null,
  "recommended_action_type": "append_text",
  "recommendation_metadata": {
    "recommended_for": ["stable single-control text entry", "first draft on validated Notepad"],
    "best_with_profiles": ["primary_full_window"],
    "validated_actions": ["append_text", "prepend_text", "write_if_missing", "append_timestamped_note"],
    "known_limitations": ["full-window OCR is broad for narrow watch zones"],
    "evidence_refs": [
      "examples/logs/phase3-append_text.json",
      "notes/phase3-validation-results.md"
    ]
  },
  "minimal_rule": {
    "name": "notepad-basic-append",
    "match": {
      "type": "contains",
      "value": "primary trigger token"
    },
    "action": {
      "type": "append_text",
      "text": "TEMPLATE_APPEND_MARKER"
    }
  },
  "related_refs": {
    "docs": [
      "docs/quickstart-notepad.md",
      "docs/validation-path.md",
      "notes/phase3-validation-results.md"
    ],
    "examples": [
      "examples/targets/primary-notepad-target.json",
      "examples/profiles/default-full-window.json",
      "examples/append_text.notepad.json"
    ],
    "evidence": [
      "examples/logs/phase3-append_text.json",
      "screenshots/examples/phase3-append_text-after.png"
    ]
  }
}
