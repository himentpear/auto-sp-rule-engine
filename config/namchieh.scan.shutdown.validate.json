{
  "description": "Real-machine validation for WeChat NamChieh chat scan with shutdown scheduling.",
  "automation": {
    "ahk_exe": "vendor/autohotkey/2.0.19/AutoHotkey64.exe"
  },
  "target_bundle": {
    "name": "wechat-chat-input",
    "window_matcher": {
      "window_title_substring": "NamChieh",
      "window_title": "NamChieh",
      "process_name": "Weixin"
    },
    "focus_strategy": {
      "type": "activate_then_wait",
      "wait_timeout_seconds": 1,
      "settle_delay_ms": 100
    },
    "control_strategy": {
      "type": "control_text",
      "control_name": "",
      "control_type": ""
    },
    "readback_strategy": {
      "type": "ocr_readback",
      "focus_strategy": {
        "type": "activate_then_wait",
        "wait_timeout_seconds": 1,
        "settle_delay_ms": 100
      }
    }
  },
  "ocr_profile": "wechat-chat-ocr",
  "ocr_profiles": {
    "wechat-chat-ocr": {
      "roi": null,
      "preprocessing": {
        "grayscale": true,
        "scale": 2.4,
        "threshold": {
          "enabled": false,
          "value": 188
        },
        "trim_border": {
          "enabled": false,
          "margin": 0
        },
        "mask_regions": [
          {
            "unit": "ratio",
            "x": 0,
            "y": 0,
            "width": 1,
            "height": 0.155
          },
          {
            "unit": "ratio",
            "x": 0,
            "y": 0.895,
            "width": 1,
            "height": 0.105
          }
        ]
      },
      "normalization": {
        "collapse_whitespace": true,
        "preserve_line_breaks": true,
        "case": "none",
        "simple_noise_cleanup": true
      },
      "behavior": {
        "fallback_to_full_window_on_empty": true
      },
      "watch": {
        "enabled": false,
        "max_checks": 1
      },
      "chat_scan": {
        "enabled": true,
        "stop_date": "2026年3月18日",
        "stop_date_patterns": [
          "2026\\s*年\\s*3\\s*月\\s*18\\s*日",
          "3\\s*月\\s*18\\s*日",
          "星期三",
          "周三"
        ],
        "max_scroll_steps": 80,
        "scroll_notches_per_step": 6,
        "scroll_settle_delay_ms": 500,
        "anchor_mode": "roi_center",
        "anchor_offset_x": 0,
        "anchor_offset_y": 0,
        "max_frames_retained": 12,
        "max_aggregated_text_chars": 120000,
        "max_per_frame_text_chars": 4000,
        "stop_on_repeated_frames": 3,
        "completion": {
          "write_summary": true,
          "summary_name": "namchieh-before-2026-03-18-shutdown-validate",
          "shutdown_after_completion": true,
          "shutdown_delay_seconds": 3600
        }
      }
    }
  },
  "engine": {
    "stop_after_first_match": true,
    "recent_rule_hit_cooldown_seconds": 0,
    "log_prefix": "namchieh-scan-shutdown-validate"
  },
  "rules": [
    {
      "name": "summarize-namchieh-before-wednesday-shutdown",
      "target": "default",
      "ocr_profile": "wechat-chat-ocr",
      "dry_run": true,
      "match": {
        "type": "regex",
        "pattern": "[\\s\\S]+"
      },
      "action": {
        "type": "append_timestamped_note",
        "text": "validated scan"
      }
    }
  ]
}
