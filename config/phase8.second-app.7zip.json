{
  "target_bundle": {
    "name": "phase8_7zip_target",
    "window_matcher": {
      "window_title_substring": "phase8-7zip-target",
      "window_title": "C:\\Users\\jisub\\Documents\\GitHub\\auto sp rule engine\\notes\\phase8-7zip-target\\",
      "process_name": "7zFM"
    },
    "focus_strategy": {
      "type": "activate_then_focus_control",
      "wait_timeout_seconds": 1.0,
      "settle_delay_ms": 150
    },
    "control_strategy": {
      "type": "control_text",
      "control_name": "Edit1",
      "control_type": "Win32Edit"
    },
    "readback_strategy": {
      "type": "control_text",
      "focus_strategy": {
        "type": "activate_then_focus_control",
        "wait_timeout_seconds": 1.0,
        "settle_delay_ms": 150
      }
    },
    "default_ocr_profile": "primary_full_window",
    "default_roi_preset": "address_bar",
    "roi_presets": {
      "address_bar": {
        "x": 12,
        "y": 122,
        "width": 560,
        "height": 42
      }
    },
    "ocr_overrides": {
      "roi_preset": "address_bar",
      "preprocessing": {
        "scale": 2.5
      }
    }
  },
  "target": {
    "window_title_substring": "phase8-7zip-target",
    "window_title": "C:\\Users\\jisub\\Documents\\GitHub\\auto sp rule engine\\notes\\phase8-7zip-target\\",
    "process_name": "7zFM"
  },
  "control": {
    "name": "Edit1",
    "type": "Win32Edit"
  },
  "automation": {
    "ahk_exe": "vendor/autohotkey/2.0.19/AutoHotkey64.exe"
  },
  "ocr_profile": "primary_full_window",
  "ocr_profiles": {
    "primary_full_window": {
      "preprocessing": {
        "grayscale": true,
        "scale": 2.0,
        "threshold": {
          "enabled": false,
          "value": 180
        },
        "trim_border": {
          "enabled": false,
          "margin": 0
        }
      },
      "normalization": {
        "collapse_whitespace": true,
        "preserve_line_breaks": false,
        "case": "lower",
        "simple_noise_cleanup": true
      },
      "watch": {
        "enabled": false,
        "polling_interval_seconds": 0.5,
        "max_checks": 1,
        "change_threshold": 0.005,
        "forced_ocr_interval_seconds": 5.0,
        "consecutive_match_count": 1
      }
    }
  },
  "engine": {
    "stop_after_first_match": true,
    "recent_rule_hit_cooldown_seconds": 0,
    "log_prefix": "phase8-7zip"
  },
  "rules": [
    {
      "name": "phase8-7zip-replace-text",
      "match": {
        "type": "contains",
        "value": "phase8 seed replace"
      },
      "action": {
        "type": "replace_text",
        "text": "PHASE8 REPLACE COMPLETE"
      }
    },
    {
      "name": "phase8-7zip-write-if-missing",
      "match": {
        "type": "contains",
        "value": "phase8 seed append"
      },
      "action": {
        "type": "write_if_missing",
        "text": "PHASE8 WRITE IF MISSING MARKER"
      }
    }
  ]
}
